datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique @db.VarChar(255)
  hashed_password String      @db.VarChar(255)
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now()) @db.Timestamptz()

  files           File[]
  access_logs     AccessLog[]

  @@map("users")
}

model File {
  id                       Int         @id @default(autoincrement())
  owner_id                 Int
  original_filename        String      @db.VarChar(255)
  stored_filename          String      @db.VarChar(255)
  extension                String      @db.VarChar(20)
  content_type             String?     @db.VarChar(100)
  size_bytes               Int
  cloudinary_public_id     String      @db.VarChar(500)
  cloudinary_resource_type String      @db.VarChar(50)
  created_at               DateTime    @default(now()) @db.Timestamptz()

  owner       User        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  share_links ShareLink[]

  @@map("files")
}

model ShareLink {
  id            Int      @id @default(autoincrement())
  file_id       Int
  token         String   @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255)
  expires_at    DateTime @db.Timestamptz()
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz()

  file File @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model AccessLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  file_id    Int?
  action     String   @db.VarChar(50)
  ip_address String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [user_id], references: [id])

  @@map("access_logs")
}
